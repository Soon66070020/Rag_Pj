# RAG-Based Medical Q&A System - Environment Variables
# Copy this file to .env and fill in your actual values

# DeepSeek API Configuration
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# Weaviate Database Configuration
WEAVIATE_URL=http://localhost:8080
# WEAVIATE_API_KEY=  # Leave empty for local development without auth

# Logging Configuration
LOG_LEVEL=INFO
LOG_DIR=./logs

# Data Directories
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
EVALUATION_DATA_DIR=./data/evaluation
OUTPUTS_DIR=./outputs

# Model Cache (HuggingFace models will be downloaded here)
HF_HOME=./models_cache
TRANSFORMERS_CACHE=./models_cache
TORCH_HOME=./models_cache

# Optional: HuggingFace API Token (for private models)
# HF_TOKEN=your_huggingface_token_here

# Development Settings
DEBUG=False
ENABLE_LOGGING=True

# Thai Language Settings
PYTHAINLP_DATA_DIR=./pythainlp_data
